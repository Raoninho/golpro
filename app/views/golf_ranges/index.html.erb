<div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
  <h1 class="mb-2 text-3xl font-bold text-green-900">
    ゴルフ練習場一覧
  </h1>

  <p class="mb-6 text-gray-600">
    大阪府内のゴルフ練習場を比較できます。
  </p>

<%# 地域検索フォーム %>
<div class="mb-6 rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
  <h2 class="mb-4 text-lg font-bold text-green-900">
    練習場を検索・比較
  </h2>

  <p class="mb-5 text-sm text-gray-600">
    地域やボール料金を条件に、自分に合った練習場を探せます。
  </p>

  <%= form_with url: golf_ranges_path, method: :get, local: true do %>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end">

      <div class="w-full sm:max-w-xs">
        <%= label_tag :city, "地域を選択", class: "mb-2 block text-sm font-semibold text-gray-700" %>

        <%= select_tag :city,
            options_for_select(
              GolfPracticeRange.distinct.order(:city).pluck(:city),
              params[:city]
            ),
            include_blank: "すべての地域",
            class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm" %>
      </div>


      <%# 料金順の並び替え %>
      <div class="w-full sm:max-w-xs">
        <%= label_tag :sort, "並び替え", class: "mb-2 block text-sm font-semibold text-gray-700" %>

        <%= select_tag :sort,
          options_for_select(
            [
              ["名前順", ""],
              ["ボール単価が安い順", "price_asc"]
            ],
            params[:sort]
          ),
          class: "w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm" %>
      </div>


      <div class="flex w-full gap-3 sm:w-auto">
        <%= submit_tag "検索",
            class: "flex-1 cursor-pointer rounded-lg bg-green-700 px-6 py-3 text-sm font-semibold text-white hover:bg-green-800 sm:flex-none" %>

        <%= link_to "リセット",
            golf_ranges_path,
            class: "flex-1 rounded-lg border border-gray-300 bg-white px-6 py-3 text-center text-sm font-semibold text-gray-700 hover:bg-gray-100 sm:flex-none" %>
      </div>


    </div>
  <% end %>
</div>

<%# 検索結果と選択中の条件 %>
<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <p class="text-lg font-bold text-gray-800">
    検索結果：<%= @golf_ranges.size %>件
  </p>

  <div class="flex flex-wrap gap-2">
    <% if params[:city].present? %>
      <span class="rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-800">
        地域：<%= params[:city] %>
      </span>
    <% end %>

    <% if params[:sort] == "price_asc" %>
      <span class="rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-800">
        ボール単価が安い順
      </span>
    <% end %>
  </div>
</div>

  <% if @golf_ranges.any? %>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% @golf_ranges.each do |range| %>
        <div class="flex min-w-0 flex-col rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6">

          <%# 施設画像 %>
          <div class="mb-4 overflow-hidden rounded-lg bg-green-50">
            <% if range.image.attached? %>
              <%= image_tag range.image,
                  alt: "#{range.name}の施設画像",
                  class: "h-24 w-full object-cover" %>
            <% else %>
              <div class="flex h-24 items-center justify-center bg-green-50 text-sm text-green-700">
                ⛳ 画像準備中
              </div>
            <% end %>
          </div>

          <h2 class="break-words text-lg font-bold text-green-900 sm:text-xl">
            <%= link_to range.name,
              golf_range_path(range),
              class: "hover:text-green-700 hover:underline" %>
          </h2>

          <p class="mt-3 text-sm text-gray-600">
            地域：<%= range.city %>
          </p>

          <p class="mt-2 text-sm text-gray-600">
            住所：<%= range.address %>
          </p>

          <p class="mt-2 text-sm text-gray-600">
            打席数：<%= range.booth_count || "情報なし" %>
          </p>

          <p class="mt-2 text-sm text-gray-600">
            距離：<%= range.yard_length ? "#{range.yard_length}ヤード" : "情報なし" %>
          </p>

          <% min_price = range.minimum_ball_price %>

          <div class="mt-auto border-t border-gray-100 pt-4">
            <p class="text-sm text-gray-500">
              最安ボール単価
            </p>

            <p class="mt-1 text-xl font-bold text-green-800">
              <%= min_price ? "#{min_price}円/球〜" : "情報なし" %>
            </p>
          </div>

          <%= link_to "詳細を見る",
              golf_range_path(range),
              class: "mt-5 block rounded-lg bg-green-700 px-5 py-3 text-center text-sm font-semibold text-white hover:bg-green-800" %>

        </div>
      <% end %>
    </div>

  <% else %>
    <div class="rounded-lg bg-white p-8 text-center shadow-sm">
      <p class="text-gray-600">
        <% if params[:city].present? %>
          該当する地域の練習場はありません。
        <% else %>
          現在、登録されている練習場はありません。
        <% end %>
      </p>
    </div>
  <% end %>
